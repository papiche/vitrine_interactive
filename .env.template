# Vitrine Interactive - Environment configuration
# Copy to .env and adjust values. Use scripts/manage_env.sh to manage.

# --- Detection zones (0-1) ---
# Left zone: hand < this ratio -> previous
VITRINE_ZONE_LEFT=0.25
# Right zone: hand > this ratio -> next
VITRINE_ZONE_RIGHT=0.75
# Center zone for detail view (comma-separated min,max)
VITRINE_ZONE_CENTER_LEFT=0.35
VITRINE_ZONE_CENTER_RIGHT=0.65

# --- Durations (seconds) ---
# Delay between swipe gestures
VITRINE_SWIPE_COOLDOWN=0.5
# Hold time for thumbs up -> capture photo
VITRINE_THUMBS_UP_HOLD_TIME=3.0
# Hold time for open hand -> open detail view
VITRINE_OPEN_HAND_HOLD_TIME=2.0
# QR code display duration after capture
VITRINE_QR_DISPLAY_TIME=10
# Return to dark mode after no hand detected (seconds)
VITRINE_DARK_MODE_TIMEOUT=30

# --- Face recognition (face_recognition_module.py) ---
# Match threshold: lower = stricter (0.6 = default)
VITRINE_FACE_MATCH_THRESHOLD=0.6
# Minimum face size in pixels
VITRINE_MIN_FACE_SIZE=50
